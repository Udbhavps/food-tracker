# App mode: "local" (default) opens straight away and keeps data in the browser, no sign-in.
# "cloud" requires sign-in and uses the Supabase values below (later phase).
# NEXT_PUBLIC_APP_MODE=local

# Copy to .env.local and fill in. Never commit .env.local.
# These three values are safe to expose to the browser (security comes from row level security in the database).

# Supabase project URL and "anon" (public) key: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the app is served (used for sign-in redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Later phases (server-only, never prefix with NEXT_PUBLIC_):
# GOOGLE_MAPS_SERVER_KEY=     # Places API, restricted by API and server
# ANTHROPIC_API_KEY=          # link parsing (Phase 2)
# SUPABASE_SERVICE_ROLE_KEY=  # only for trusted server jobs, never in the browser
